PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# URL pública del backend (se antepone a las rutas /uploads/... de las imágenes)
PUBLIC_URL=http://localhost:5000
# Días que se conserva una publicación borrada antes de eliminarla definitivamente
DELETED_RETENTION_DAYS=30

# --- Exportación a Google Sheets (Google Apps Script Web App) ---
# URL de la Web App publicada (termina en /exec) y la API key que valida tu script
# Asistente de chat (clave gratis en https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Notificaciones push al dispositivo: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_API_KEY=

# Nombre del campo donde tu script espera la key y dónde viaja (body | query)
GOOGLE_SHEETS_KEY_PARAM=api_key
GOOGLE_SHEETS_KEY_IN=body
# Envío automático cada N minutos (0 = desactivado; manual con: npm run export:sheets)
GOOGLE_SHEETS_EXPORT_INTERVAL_MIN=0

# --- Producción (Railway: ver ../DEPLOY.md) ---
# NODE_ENV=production
# SERVE_FRONTEND=true      # el backend sirve el frontend compilado (mismo origen; no hace falta CLIENT_ORIGIN/PUBLIC_URL)
# TRUST_PROXY=1            # detrás del proxy de Railway/Render
# DATA_DIR=/data/db        # base SQLite en el volumen persistente
# UPLOAD_DIR=/data/uploads # fotos en el volumen persistente
